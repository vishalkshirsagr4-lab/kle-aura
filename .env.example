# ---- AI-AURA environment (copy to .env and fill in) ----
# The repo-root .env is read by both the API and the unified server.

# Port for the unified server (frontend + API on one origin).
PORT=3000
# Port used only when the API runs on its own (`npm run dev:api`).
API_PORT=5000

# MongoDB connection string. Leave empty to use the in-memory store.
MONGO_URI=

# Admin portal login (the username is case-insensitive, the password is not).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=change-this-to-a-long-random-string

# Public backend origin for the frontend bundle. Leave empty when the API is
# served from the same origin as the frontend. Never put credentials here.
REACT_APP_API_URL=

# Where the frontend dev server proxies /api when the API runs separately.
VITE_PROXY_TARGET=http://localhost:5000

# Optional: Gemini API key.
GEMINI_API_KEY=
