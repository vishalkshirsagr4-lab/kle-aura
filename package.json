{
  "name": "ai-aura",
  "version": "1.0.0",
  "private": true,
  "description": "AI-AURA - PUC college event website (React + Vite frontend, Express + MongoDB API)",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "tsx backend/server.ts",
    "dev:web": "npm run dev --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "NODE_ENV=production tsx backend/server.ts",
    "preview": "npm run preview --workspace frontend",
    "fetch-images": "npm run fetch-images --workspace frontend",
    "lint": "echo 'No linter configured'"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
